{
  "name": "@sanjaydoppalapudi/agentplatform",
  "version": "0.1.15",
  "description": "Agent Platform (ap) — minimal, fast coding agent CLI (OpenAI-compatible providers)",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanjay-doppalapudi/Agent-Platform.git"
  },
  "homepage": "https://github.com/Sanjay-doppalapudi/Agent-Platform#readme",
  "bugs": {
    "url": "https://github.com/Sanjay-doppalapudi/Agent-Platform/issues"
  },
  "keywords": [
    "agent",
    "cli",
    "coding-agent",
    "llm",
    "mcp",
    "acp",
    "openai-compatible",
    "bun"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "ap": "src/index.ts"
  },
  "files": [
    "src",
    "ap.config.example.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CREDITS.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "push": "bun scripts/push.ts",
    "test": "bun test tests",
    "smoke": "bun run scripts/smoke-userpath.ts",
    "typecheck": "bun x tsc --noEmit",
    "compile": "bun build --compile --minify src/index.ts --outfile ap.exe && ap.exe --version",
    "dist": "bun run dist:win && bun run dist:linux && bun run dist:mac-arm && bun run dist:mac-x64",
    "dist:win": "bun build --compile --minify --target=bun-windows-x64 src/index.ts --outfile dist/ap-windows-x64.exe",
    "dist:linux": "bun build --compile --minify --target=bun-linux-x64 src/index.ts --outfile dist/ap-linux-x64",
    "dist:mac-arm": "bun build --compile --minify --target=bun-darwin-arm64 src/index.ts --outfile dist/ap-darwin-arm64",
    "dist:mac-x64": "bun build --compile --minify --target=bun-darwin-x64 src/index.ts --outfile dist/ap-darwin-x64"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "typescript": "5.9.2"
  }
}
