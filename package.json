{
  "name": "harness",
  "version": "0.1.0",
  "description": "Minimal, fast coding agent CLI (OpenAI-compatible providers)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanjay-doppalapudi/Agent-Platform.git"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "harness": "src/index.ts"
  },
  "files": [
    "src",
    "harness.config.example.json",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "typecheck": "bun x tsc --noEmit",
    "compile": "bun build --compile --minify src/index.ts --outfile harness.exe && harness.exe --version",
    "dist": "bun run dist:win && bun run dist:linux && bun run dist:mac-arm && bun run dist:mac-x64",
    "dist:win": "bun build --compile --minify --target=bun-windows-x64 src/index.ts --outfile dist/harness-windows-x64.exe",
    "dist:linux": "bun build --compile --minify --target=bun-linux-x64 src/index.ts --outfile dist/harness-linux-x64",
    "dist:mac-arm": "bun build --compile --minify --target=bun-darwin-arm64 src/index.ts --outfile dist/harness-darwin-arm64",
    "dist:mac-x64": "bun build --compile --minify --target=bun-darwin-x64 src/index.ts --outfile dist/harness-darwin-x64"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0"
  }
}
